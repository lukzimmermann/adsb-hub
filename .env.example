POSTGRES_DB=adsb
POSTGRES_USER=adsb
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://adsb:change-me@localhost:5432/adsb
CONFIG_PATH=config.yaml
POLL_INTERVAL_SECONDS=15
HTTP_TIMEOUT_SECONDS=10
USER_AGENT=adsb/0.1.0
API_PORT=8000
JWT_SECRET=change-me-to-a-long-random-value
JWT_EXPIRES_MINUTES=1440
COOKIE_SECURE=false
AIRCRAFT_RATE_LIMIT_SECONDS=60
# '*' trusts X-Forwarded-For from anyone reaching the API. Safe only if the
# API port is not reachable directly (only via the reverse proxy). Once the
# proxy's address is fixed, narrow this to its IP/CIDR instead.
FORWARDED_ALLOW_IPS=*